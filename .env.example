DATABASE_URL="postgresql://postgres:password@localhost:5432/stock_alert"

# Secret for signing sessions / reset tokens (generate: openssl rand -base64 32)
AUTH_SECRET="change-this-secret"

NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Web Push VAPID keys — generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:admin@example.com"

# Market data provider: mock | twelvedata | alphavantage | finnhub
# "mock" is for DEVELOPMENT ONLY — never use fake prices in production
MARKET_DATA_PROVIDER="mock"
TWELVE_DATA_API_KEY=""
ALPHA_VANTAGE_API_KEY=""
FINNHUB_API_KEY=""

# Background worker
POLLING_INTERVAL_SECONDS="60"

# Optional: not required by default implementation (DB-based locking is used)
REDIS_URL="redis://localhost:6379"

# Sound upload limits
MAX_SOUND_FILE_SIZE_MB="10"
MAX_SOUND_DURATION_SECONDS="30"
