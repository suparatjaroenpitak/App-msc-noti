[TEMPLATE]
# SQLite — ไม่ต้องมีเซิร์ฟเวอร์ DB อีกต่อไป (เลี่ยงปัญหา Postgres ฟรีบน Render ถูก suspend/expire)
# ⚠️ path แบบ relative ถูก resolve เทียบกับโฟลเดอร์ prisma/ (convention ของ Prisma)
#    file:./dev.db → ไฟล์จริงคือ prisma/dev.db
# ใน Docker ใช้ absolute path เสมอ: file:/app/data/stock-alert.db (mount volume เพื่อ persist)
DATABASE_URL="file:./dev.db"

# Secret for signing sessions / reset tokens (generate: openssl rand -base64 32)
AUTH_SECRET="change-this-secret"

NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Web Push VAPID keys — generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:admin@example.com"

# Market data provider: mock | twelvedata | alphavantage | finnhub
# "mock" is for DEVELOPMENT ONLY — never use fake prices in production
MARKET_DATA_PROVIDER="mock"
TWELVE_DATA_API_KEY=""
ALPHA_VANTAGE_API_KEY=""
FINNHUB_API_KEY=""

# Background worker (ใน Docker รวมอยู่ใน container เดียวกับ app ผ่าน RUN_WORKER_IN_WEB=true)
POLLING_INTERVAL_SECONDS="60"

# Deploy hardening (optional) — กัน start command ค้างจน Render "Port scan timeout"
# MIGRATE_TIMEOUT_SECONDS="300"      # เวลาสูงสุดของ `prisma migrate deploy`
# SEED_TIMEOUT_SECONDS="180"         # เวลาสูงสุดของ seed (เมื่อ FRESH_DB_SEED=true)

# AI (Ollama on Colab) — per-user settings stored in DB via Settings → AI
# No server-wide secret needed. Only tunnel domains (trycloudflare/ngrok/localtunnel)
# are accepted in production; localhost is additionally allowed in development.

# Optional: not required by default implementation (DB-based locking is used)
REDIS_URL="redis://localhost:6379"

# Sound upload limits
MAX_SOUND_FILE_SIZE_MB="10"
MAX_SOUND_DURATION_SECONDS="30"
