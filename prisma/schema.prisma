// Stock Alert PWA — Prisma schema (SQLite)
// Prices use Float (SQLite ไม่มี DECIMAL — เก็บ 4 ตำแหน่งเลขจริงเพียงพอสำหรับราคาหุ้น)
// All timestamps are UTC (Prisma DateTime stored as TEXT ISO-8601 in SQLite)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// SQLite ไม่รองรับ Prisma enum จึงใช้ String + string-literal types (ดู src/types/enums.ts)
// ค่าที่อนุญาต: STOCK | ETF ฯลฯ — application ตรวจสอบด้วย Zod ก่อนเขียนลง DB เสมอ

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  image        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  sessions               Session[]
  passwordResetTokens    PasswordResetToken[]
  watchlistItems         WatchlistItem[]
  alertRules             AlertRule[]
  alertEvents            AlertEvent[]
  pushSubscriptions      PushSubscription[]
  notificationPreference NotificationPreference?
  notificationSounds     NotificationSound[]
  notificationLogs       NotificationLog[]
  analysisSettings       AnalysisSettings?
  analyses               Analysis[]
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  userAgent String?
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Asset {
  id        String   @id @default(cuid())
  symbol    String   @unique
  name      String
  exchange  String
  type      String // "STOCK" | "ETF"
  currency  String   @default("USD")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  watchlistItems WatchlistItem[]
  alertRules     AlertRule[]
  priceSamples   PriceSample[]
  analyses       Analysis[]
}

model WatchlistItem {
  id        String   @id @default(cuid())
  userId    String
  assetId   String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  asset Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@unique([userId, assetId])
  @@index([userId, sortOrder])
}

model AlertRule {
  id                  String    @id @default(cuid())
  userId              String
  assetId             String
  name                String
  type                String // "ENTRY" | "EXIT" | "CUSTOM"
  condition           String // "ABOVE_OR_EQUAL" | "BELOW_OR_EQUAL"
  targetPrice         Float
  enabled             Boolean   @default(true)
  oneTime             Boolean   @default(false)
  cooldownMinutes     Int       @default(60)
  notificationMessage String?
  soundId             String?
  lastTriggeredAt     DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  asset       Asset              @relation(fields: [assetId], references: [id], onDelete: Cascade)
  sound       NotificationSound? @relation(fields: [soundId], references: [id], onDelete: SetNull)
  alertEvents AlertEvent[]

  @@unique([userId, assetId, name])
  @@index([userId, enabled])
  @@index([assetId, enabled])
}

model AlertEvent {
  id           String   @id @default(cuid())
  alertRuleId  String
  userId       String
  symbol       String
  currentPrice Float
  targetPrice  Float
  triggeredAt  DateTime @default(now())
  status       String // "TRIGGERED" | "FAILED"
  metadata     Json?

  alertRule AlertRule @relation(fields: [alertRuleId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  notificationLogs NotificationLog[]
  analyses         Analysis[]

  @@index([alertRuleId, triggeredAt])
  @@index([userId, triggeredAt])
  @@index([alertRuleId])
}

model PushSubscription {
  id         String   @id @default(cuid())
  userId     String
  endpoint   String   @unique
  p256dh     String
  auth       String
  userAgent  String?
  deviceName String?
  lastUsedAt DateTime @default(now())
  createdAt  DateTime @default(now())

  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  notificationLogs NotificationLog[]
}

model NotificationPreference {
  id             String   @id @default(cuid())
  userId         String   @unique
  pushEnabled    Boolean  @default(true)
  entryEnabled   Boolean  @default(true)
  exitEnabled    Boolean  @default(true)
  customEnabled  Boolean  @default(true)
  defaultSoundId String?
  volume         Float    @default(0.8)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  defaultSound NotificationSound? @relation("defaultSound", fields: [defaultSoundId], references: [id], onDelete: SetNull)
}

model NotificationSound {
  id        String   @id @default(cuid())
  userId    String
  name      String
  fileUrl   String
  mimeType  String
  fileSize  Int
  duration  Float?
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user             User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  alertRules       AlertRule[]
  preferredByUsers NotificationPreference[] @relation("defaultSound")
}

model NotificationLog {
  id                 String   @id @default(cuid())
  userId             String
  alertEventId       String?
  pushSubscriptionId String?
  title              String
  body               String
  status             String // "SENT" | "FAILED"
  errorMessage       String?
  sentAt             DateTime @default(now())

  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  alertEvent       AlertEvent?       @relation(fields: [alertEventId], references: [id], onDelete: SetNull)
  pushSubscription PushSubscription? @relation(fields: [pushSubscriptionId], references: [id], onDelete: SetNull)

  @@index([userId, sentAt])
  @@index([alertEventId])
}

/// Per-user settings for the BUILT-IN analysis engine (no external AI service).
model AnalysisSettings {
  id               String   @id @default(cuid())
  userId           String   @unique
  enabled          Boolean  @default(true)
  suggestOnCreate  Boolean  @default(true)
  analyzeOnTrigger Boolean  @default(false)
  lookbackMinutes  Int      @default(240)
  minSamples       Int      @default(12)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Rolling price history captured by the worker — the fuel for the analysis engine.
model PriceSample {
  id        String   @id @default(cuid())
  assetId   String
  symbol    String
  price     Float
  volume    Int?
  sampledAt DateTime @default(now())

  asset Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@unique([assetId, sampledAt])
  @@index([assetId, sampledAt])
  @@index([sampledAt])
}

/// Output of the built-in analysis engine (replaces the old external-AI model).
model Analysis {
  id                   String   @id @default(cuid())
  userId               String
  assetId              String
  alertEventId         String?
  symbol               String
  kind                 String // "ON_TRIGGER" | "SUGGEST_PRICE"
  priceAtAnalysis      Float
  engine               String   @default("builtin-v1")
  verdict              String? // "BUY" | "WAIT" | "AVOID"
  suggestedEntryPrice  Float?
  suggestedStopPrice   Float?
  suggestedTargetPrice Float?
  confidence           Float?
  horizonDays          Int?
  rationale            String?
  indicators           Json?
  ok                   Boolean
  error                String?
  durationMs           Int?
  createdAt            DateTime @default(now())

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  asset      Asset       @relation(fields: [assetId], references: [id], onDelete: Cascade)
  alertEvent AlertEvent? @relation(fields: [alertEventId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([symbol, createdAt])
  @@index([alertEventId])
}
